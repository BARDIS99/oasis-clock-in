{
  "name": "oasis-clock-in",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "overrides": { "nf3": "0.3.17" },
  "scripts": {
    "dev": "cd frontend && node ../backend/scripts/with-app-env.mjs vite dev --host 0.0.0.0 --port 8080",
    "build": "cd frontend && node ../backend/scripts/with-app-env.mjs vite build && cd .. && npm run db:migrate",
    "db:migrate": "node backend/scripts/migrate.mjs",
    "build:dev": "cd frontend && node ../backend/scripts/with-app-env.mjs vite build --mode development",
    "preview": "cd frontend && node ../backend/scripts/with-app-env.mjs vite preview",
    "typecheck": "cd frontend && tsc --noEmit"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.4",
    "@supabase/supabase-js": "^2.115.0",
    "@tailwindcss/vite": "^4.3.0",
    "@tanstack/react-query": "^5.101.0",
    "@tanstack/react-router": "^1.170.0",
    "@tanstack/react-start": "^1.168.0",
    "@tanstack/router-plugin": "^1.168.0",
    "better-auth": "~1.6.30",
    "jose": "6.2.9",
    "kysely": "^0.28.5",
    "lucide-react": "^0.510.0",
    "pg": "^8.16.3",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sonner": "^2.0.7",
    "tailwindcss": "^4.3.0",
    "zod": "^4.4.0"
  },
  "devDependencies": {
    "@types/node": "^22.16.5",
    "@types/pg": "^8.11.10",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.2.0",
    "nitro": "3.0.260610-beta",
    "typescript": "^5.7.0",
    "vite": "^8.2.0"
  }
}
